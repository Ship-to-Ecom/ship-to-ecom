DATABASE_URL="file:./dev.db"
APP_SECRET="64-hex-karakter (openssl rand -hex 32)"
APP_URL="http://localhost:3000"
CRON_SECRET="rastgele-bir-anahtar"
# Yayında ayrı cron servisi yoksa: uygulama /api/cron/sync'i bu kadar dakikada bir kendisi çağırır (yerelde boş bırakın).
INTERNAL_CRON_MINUTES=""
# Yönetim panelinde (/backoffice) ilk yönetici hesabını oluştururken sorulan anahtar
ADMIN_SETUP_KEY="rastgele-bir-anahtar"
# Lisans ödemesi için havale/EFT bilgileri (ödeme ekranında gösterilir)
BANK_ACCOUNT_NAME="Şirket Unvanı"
BANK_IBAN="TR00 0000 0000 0000 0000 0000 00"
BANK_NAME=""
# Meta (Facebook) reklam bağlantısı (isteğe bağlı): Meta for Developers uygulama kimliği ve sırrı.
# Yönlendirme adresi: <APP_URL>/api/meta/callback (https olmalı). İstenen izin: ads_read.
META_APP_ID=""
META_APP_SECRET=""
# Google Ads bağlantısı (isteğe bağlı): Google Cloud OAuth istemcisi (Web uygulaması).
# Yönlendirme adresi: <APP_URL>/api/google/callback. Cloud projesinin Google Ads API erişimi onaylı olmalı.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Belgeye göre geliştirici anahtarları Eylül 2026'da kaldırıldı; tanımlanırsa başlıkta gönderilir, sunucu yok sayar.
GOOGLE_ADS_DEVELOPER_TOKEN=""
# GA4 aynı OAuth istemcisini kullanır; ek yönlendirme adresi: <APP_URL>/api/ga4/callback
# Cloud projesinde "Google Analytics Data API" ve "Google Analytics Admin API" açık olmalı.
# Akıllı Reklam Analizi metin anlatımı (isteğe bağlı). Tanımlı değilse kural motoru yalnız çalışır.
# AI_PROVIDER şu an yalnızca "anthropic" olabilir; AI_MODEL boşsa claude-opus-5-5 kullanılır.
AI_PROVIDER=""
